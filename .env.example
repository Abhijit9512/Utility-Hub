# UtilityHub — Environment Variables
# This project needs no paid APIs. Most features work without env vars.
# Optional:

# Site URL used for canonical + sitemap
# VITE_SITE_URL=https://utilityhub.example.com

# Optional Google Analytics
# VITE_GA_ID=G-XXXXXXXXXX

# Optional AdSense client
# VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
